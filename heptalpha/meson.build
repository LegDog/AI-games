project('heptalpha', 'c', version: '1.0.0', license: 'GPL-3.0-or-later', license_files: 'COPYING',
  default_options: ['c_std=c11', 'warning_level=3'])
glib = dependency('glib-2.0', version: '>=2.66', include_type: 'system')
math = meson.get_compiler('c').find_library('m', required: true)
engine = static_library('game', ['src/game.c', 'src/board.c', 'src/search.c', 'src/animation.c', 'src/i18n.c'], dependencies: [glib, math])
engine_dep = declare_dependency(link_with: engine, dependencies: [glib, math], include_directories: include_directories('src'))
executable('puzzle-runner', 'src/runner.c', dependencies: engine_dep)
test('game', executable('test-game', 'tests/test-game.c', dependencies: engine_dep))
test('search', executable('test-search', 'tests/test-search.c', dependencies: engine_dep), timeout: 120)
test('board', executable('test-board', 'tests/test-board.c', dependencies: engine_dep))
test('animation', executable('test-animation', 'tests/test-animation.c', dependencies: engine_dep))
test('i18n', executable('test-i18n', 'tests/test-i18n.c', dependencies: engine_dep))
if get_option('app')
  gtk = dependency('gtk4', version: '>=4.10', include_type: 'system')
  adw = dependency('libadwaita-1', version: '>=1.4', include_type: 'system')
  soup = dependency('libsoup-3.0', version: '>=3.0', include_type: 'system')
  json = dependency('json-glib-1.0', version: '>=1.6', include_type: 'system')
  ollama = static_library('ollama', '../tools/ollama-events.c', 'src/ollama.c', dependencies: [engine_dep, soup, json])
  ollama_dep = declare_dependency(link_with: ollama, dependencies: [engine_dep, soup, json])
  viewer=static_library('ollama-view','../tools/ollama-view.c',dependencies:[ollama_dep,gtk,adw])
  viewer_dep=declare_dependency(link_with:viewer,dependencies:[ollama_dep,gtk,adw])
  gnome = import('gnome')
  resources = gnome.compile_resources('heptalpha-resources', 'data/resources.xml', source_dir: 'data')
  app_deps = [viewer_dep, ollama_dep, gtk, adw]
  executable('heptalpha', ['src/main.c', resources], dependencies: app_deps, install: true)
  test('ollama', executable('test-ollama', 'tests/test-ollama.c', dependencies: ollama_dep), timeout: 30)
  test('ollama-log', executable('test-ollama-log', 'tests/test-ollama-log.c', dependencies: ollama_dep), timeout: 30)
  if get_option('ui_tests')
    test('ui', executable('test-ui', ['tests/test-ui.c', resources], dependencies: app_deps), timeout: 45)
    executable('screenshot', ['tests/screenshot.c', resources], dependencies: app_deps)
  endif
  install_data('data/io.github.aigames.Heptalpha.desktop', install_dir: get_option('datadir') / 'applications')
  install_data('data/io.github.aigames.Heptalpha.svg', install_dir: get_option('datadir') / 'icons/hicolor/scalable/apps')
endif
